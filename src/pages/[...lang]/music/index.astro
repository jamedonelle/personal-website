---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import EmptyState from '../../../components/EmptyState.astro';
import PixelRecordPlayer from '../../../components/PixelRecordPlayer.astro';
import { albumCover } from '../../../lib/covers';
import { getLang, href, langParams, ui } from '../../../lib/i18n';

export const getStaticPaths = () => langParams.map((params) => ({ params }));

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const lang = getLang(Astro.url);
const t = ui[lang];
const entries = await getCollection('music');
const albums = entries.filter((e) => e.data.kind === 'album');

// On repeat keeps the order it was given; favorites group by artist, oldest album first.
const onRepeat = albums
  .filter((a) => a.data.status === 'on-repeat')
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
const favorites = albums
  .filter((a) => a.data.status === 'favorite')
  .sort(
    (a, b) =>
      (a.data.artist ?? '').localeCompare(b.data.artist ?? '') ||
      (a.data.year ?? 0) - (b.data.year ?? 0) ||
      a.data.title.localeCompare(b.data.title),
  );
const playlists = entries
  .filter((e) => e.data.kind === 'playlist')
  .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

const topSections = [onRepeat, favorites].filter((s) => s.length > 0);

// Album art is looked up at build time; a `cover:` in the file overrides it.
const coverFor = new Map<string, string | undefined>(
  await Promise.all(
    [...onRepeat, ...favorites].map(async (a) => {
      const own = a.data.cover;
      if (own) return [a.id, own.startsWith('http') ? own : `${base}${own}`] as const;
      const found = a.data.artist ? await albumCover(a.data.artist, a.data.title, a.data.year) : undefined;
      return [a.id, found] as const;
    }),
  ),
);
---

<Base title={t.music} wide>
  <h1 class="page-title">{t.music}</h1>
  {entries.length === 0 && <EmptyState variant="music" />}

  {topSections.length > 0 && (
    <div class:list={['split', { single: topSections.length < 2 }]}>
      {onRepeat.length > 0 && (
        <section>
          <h2>{t.onRepeat}</h2>
          <ul class="repeat-list">
            {onRepeat.map((a) => (
              <li>
                <a class="repeat-art" href={href(lang, `/music/${a.id}/`)}>
                  {coverFor.get(a.id) ? (
                    <img src={coverFor.get(a.id)} alt={t.albumCover(a.data.title)} />
                  ) : (
                    <span class="cover-blank">{a.data.title}</span>
                  )}
                </a>
                <div class="repeat-text">
                  <a class="cover-title" href={href(lang, `/music/${a.id}/`)}>{a.data.title}</a>
                  <span class="meta">{a.data.artist}</span>
                </div>
              </li>
            ))}
          </ul>
        </section>
      )}

      {onRepeat.length > 0 && favorites.length > 0 && (
        <div class="split-middle">
          <PixelRecordPlayer scale={7} />
        </div>
      )}

      {favorites.length > 0 && (
        <section>
          <h2>{t.favoriteAlbums}</h2>
          <ul class="sleeves">
            {favorites.map((a) => (
              <li>
                <a
                  class="sleeve"
                  href={href(lang, `/music/${a.id}/`)}
                  title={`${a.data.title} · ${a.data.artist}${a.data.year ? ` · ${a.data.year}` : ''}`}
                >
                  <span class="vinyl" aria-hidden="true"></span>
                  {coverFor.get(a.id) ? (
                    <img src={coverFor.get(a.id)} alt={t.albumCover(a.data.title)} loading="lazy" />
                  ) : (
                    <span class="sleeve-blank">{a.data.title}</span>
                  )}
                </a>
                <span class="sleeve-title">{a.data.title}</span>
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>
  )}

  {playlists.length > 0 && (
    <section class="playlists">
      <h2>{t.playlists}</h2>
      <ul class="playlist-grid">
        {playlists.map((p) => (
          <li class="playlist-card">
            <h3>{p.data.title}</h3>
            {p.data.description && <p>{p.data.description}</p>}
            {p.data.link ? (
              <a href={p.data.link} target="_blank" rel="noopener noreferrer">{t.listen} →</a>
            ) : (
              <span class="meta">{t.linkSoon}</span>
            )}
          </li>
        ))}
      </ul>
    </section>
  )}
</Base>

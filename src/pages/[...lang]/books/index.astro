---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import EmptyState from '../../../components/EmptyState.astro';
import PixelBook from '../../../components/PixelBook.astro';
import { getLang, href, langParams, ui } from '../../../lib/i18n';

export const getStaticPaths = () => langParams.map((params) => ({ params }));

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const lang = getLang(Astro.url);
const t = ui[lang];
const books = await getCollection('books');
// Newest finish date first; books without a date follow, alphabetically.
const byFinished = (a: (typeof books)[number], b: (typeof books)[number]) => {
  const da = a.data.finished?.valueOf();
  const db = b.data.finished?.valueOf();
  if (da !== undefined && db !== undefined) return db - da;
  if (da !== undefined) return -1;
  if (db !== undefined) return 1;
  return a.data.title.localeCompare(b.data.title);
};
const groups = [
  {
    key: 'reading',
    label: t.currentlyReading,
    items: books.filter((b) => b.data.status === 'reading'),
  },
  {
    key: 'finished',
    label: t.previouslyRead,
    items: books.filter((b) => b.data.status === 'finished').sort(byFinished),
  },
].filter((g) => g.items.length > 0);

// Text stars for the hover tooltip, where the pixel stars can't go; ½ marks a half star.
const stars = (n?: number) =>
  n ? '★'.repeat(Math.floor(n)) + (n % 1 ? '½' : '') + '☆'.repeat(5 - Math.ceil(n)) : '';
---

<Base title={t.books} wide>
  <h1 class="page-title">{t.books}</h1>
  {groups.length === 0 && <EmptyState variant="books" />}
  <div class:list={['split', { single: groups.length < 2 }]}>
    {groups.map((g, i) => (
      <>
        {i === 1 && (
          <div class="split-middle">
            <PixelBook scale={7} />
          </div>
        )}
      <section>
        <h2>{g.label}</h2>
        {g.key === 'reading' ? (
          <ul class="cover-grid big">
            {g.items.map((b) => (
              <li class="cover-card">
                <a class="cover-link" href={href(lang, `/books/${b.id}/`)}>
                  {b.data.cover ? (
                    <img class="cover" src={`${base}${b.data.cover}`} alt={t.bookCover(b.data.title)} />
                  ) : (
                    <div class="cover cover-blank">{b.data.title}</div>
                  )}
                  <span class="cover-title">{b.data.title}</span>
                </a>
                <span class="meta">{b.data.author}</span>
              </li>
            ))}
          </ul>
        ) : (
          <div class="shelf-frame">
            <ul class="shelf">
              {g.items.map((b) => (
                <li>
                  <a
                    class="spine"
                    href={href(lang, `/books/${b.id}/`)}
                    title={`${b.data.title} · ${b.data.author}${b.data.rating ? ` · ${stars(b.data.rating)}` : ''}`}
                  >
                    {b.data.cover ? (
                      <img src={`${base}${b.data.cover}`} alt={t.bookCover(b.data.title)} loading="lazy" />
                    ) : (
                      <span class="spine-blank">{b.data.title}</span>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </section>
      </>
    ))}
  </div>
</Base>

---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import EmptyState from '../../../components/EmptyState.astro';
import { formatDate, frenchOf, getLang, href, langParams, ui } from '../../../lib/i18n';

export const getStaticPaths = () => langParams.map((params) => ({ params }));

const lang = getLang(Astro.url);
const t = ui[lang];
const posts = (await getCollection('blog', (p) => !p.data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
// On French pages a post's title and description come from blog/fr/ when it has been translated.
const french = new Map(
  lang === 'fr' ? await Promise.all(posts.map(async (p) => [p.id, (await frenchOf('blog', p.id))?.data] as const)) : [],
);
---

<Base title={t.blog}>
  <h1>{t.blog}</h1>
  {posts.length === 0 && <EmptyState variant="blog" />}
  <ul class="list">
    {posts.map((p) => {
      const words = french.get(p.id);
      return (
        <li lang={lang === 'fr' && !words ? 'en' : undefined}>
          <h3><a href={href(lang, `/blog/${p.id}/`)}>{words?.title ?? p.data.title}</a></h3>
          <span class="meta" lang={lang}>{formatDate(lang, p.data.pubDate)}</span>
          <p>{words?.description ?? p.data.description}</p>
          <div>{p.data.tags.map((t) => <span class="tag">{t}</span>)}</div>
        </li>
      );
    })}
  </ul>
</Base>

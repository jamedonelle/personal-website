---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { albumCover } from '../../lib/covers';

export async function getStaticPaths() {
  const entries = await getCollection('music');
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { Content } = await render(entry);
// Same lookup as the music index: a `cover:` in the file wins, otherwise ask iTunes.
const own = entry.data.cover;
const cover = own
  ? own.startsWith('http') ? own : `${base}${own}`
  : entry.data.artist ? await albumCover(entry.data.artist, entry.data.title, entry.data.year) : undefined;
const stars = (n?: number) => (n ? '★'.repeat(n) + '☆'.repeat(5 - n) : '');
---

<Base title={entry.data.title}>
  <article>
    <header class="detail-head">
      {cover ? (
        <img class="detail-cover" src={cover} alt={`Cover of ${entry.data.title}`} />
      ) : (
        <div class="detail-cover cover-blank">{entry.data.title}</div>
      )}
      <div class="detail-text">
        <h1>{entry.data.title}</h1>
        {entry.data.artist && <p class="detail-by">{entry.data.artist}</p>}
        <p class="meta">
          {entry.data.year}
          {entry.data.rating && <>{entry.data.year && ' · '}{stars(entry.data.rating)}</>}
          {entry.data.link && <>{(entry.data.year || entry.data.rating) && ' · '}<a href={entry.data.link}>Listen</a></>}
        </p>
      </div>
    </header>
    <Content />
  </article>
</Base>

---
import '../styles/global.css';
import DitherBackground from '../components/DitherBackground.astro';

interface Props {
  title: string;
  description?: string;
  wide?: boolean;
}

const { title, description = 'My personal site: writing, books, and music.', wide = false } = Astro.props;
// Header and footer are the same width on every page; only the page content narrows.
const chrome = 'wrap wide';
const content = wide ? 'wrap wide' : 'wrap wide narrow';

// BASE_URL respects the `base` option, so links keep working on a GitHub project site.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname;
const nav = [
  { href: `${base}/blog/`, label: 'Blog' },
  { href: `${base}/books/`, label: 'Books' },
  { href: `${base}/music/`, label: 'Music' },
];
const fullTitle = title === 'Home' ? 'James Donelle' : `${title} · James Donelle`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="icon" type="image/png" sizes="64x64" href={`${base}/favicon.png`} />
    <link rel="alternate" type="application/rss+xml" title="Blog" href={`${base}/rss.xml`} />
  </head>
  <body>
    <header class="site">
      <div class={chrome}>
        <a class="brand" href={`${base}/`}>James Donelle</a>
        <nav>
          {nav.map((n) => (
            <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main class={content}>
      {/* the levels lift the sky so it reads as mostly sage */}
      <DitherBackground src="/jerry-zhang-SJGiS1JzUCc-unsplash.jpg" levels={[40, 180]} />
      <slot />
    </main>
    <footer class="site">
      <div class={chrome}>© {new Date().getFullYear()} James Donelle</div>
    </footer>
  </body>
</html>
